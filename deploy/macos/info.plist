<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>SparkNotePad</string>
	<key>CFBundleName</key>
	<string>SparkNotePad</string>
	<key>CFBundleDisplayName</key>
	<string>SparkNotePad</string>
	<key>CFBundleIconFile</key>
	<string>SparkNotePad.icns</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.alsyundawy.SparkNotePad</string>
	<key>CFBundleShortVersionString</key>
	<string>${QMAKE_FULL_VERSION}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSMinimumSystemVersion</key>
	<string>${MACOSX_DEPLOYMENT_TARGET}</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Plain Text Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>txt</string>
				<string>text</string>
				<string>log</string>
				<string>ini</string>
				<string>cfg</string>
				<string>conf</string>
				<string>md</string>
				<string>markdown</string>
			</array>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.text</string>
				<string>public.plain-text</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Source Code File</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>c</string>
				<string>h</string>
				<string>cpp</string>
				<string>hpp</string>
				<string>cc</string>
				<string>cxx</string>
				<string>m</string>
				<string>mm</string>
				<string>py</string>
				<string>js</string>
				<string>ts</string>
				<string>json</string>
				<string>xml</string>
				<string>html</string>
				<string>htm</string>
				<string>css</string>
				<string>sh</string>
				<string>bash</string>
				<string>zsh</string>
				<string>bat</string>
				<string>cmd</string>
				<string>rc</string>
				<string>lua</string>
				<string>rs</string>
				<string>go</string>
				<string>php</string>
				<string>java</string>
				<string>sql</string>
				<string>yaml</string>
				<string>yml</string>
			</array>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.source-code</string>
				<string>public.c-source</string>
				<string>public.c-header</string>
				<string>public.c-plus-plus-source</string>
				<string>public.c-plus-plus-header</string>
				<string>public.python-script</string>
				<string>public.shell-script</string>
				<string>com.netscape.javascript-source</string>
				<string>public.json</string>
				<string>public.xml</string>
				<string>public.html</string>
				<string>public.css</string>
				<string>public.yaml</string>
			</array>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>SparkNotePad: New Document with Selection</string>
			</dict>
			<key>NSMessage</key>
			<string>openSelectionService</string>
			<key>NSPasteboardOptions</key>
			<dict>
				<key>NSSendTypes</key>
				<array>
					<string>public.utf8-plain-text</string>
					<string>NSStringPboardType</string>
				</array>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>SparkNotePad: Append Selection to Current Document</string>
			</dict>
			<key>NSMessage</key>
			<string>appendSelectionService</string>
			<key>NSPasteboardOptions</key>
			<dict>
				<key>NSSendTypes</key>
				<array>
					<string>public.utf8-plain-text</string>
					<string>NSStringPboardType</string>
				</array>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>SparkNotePad: Open File</string>
			</dict>
			<key>NSMessage</key>
			<string>openFileService</string>
			<key>NSPasteboardOptions</key>
			<dict>
				<key>NSSendFileTypes</key>
				<array>
					<string>public.plain-text</string>
					<string>public.source-code</string>
				</array>
			</dict>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.plain-text</string>
				<string>public.source-code</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
